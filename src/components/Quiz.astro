---
// Composant Quiz — QCM autonome, validation côté client, seuil 80 %.
//
// Usage en MDX :
//
//   import Quiz from '../../../components/Quiz.astro';
//
//   <Quiz
//     id="m00"
//     questions={[
//       {
//         question: 'Sur quelle voie émet-on un appel de détresse en phonie ?',
//         choices: ['voie 06', 'voie 16', 'voie 70', 'voie 72'],
//         answer: 1,
//         explanation: 'La voie 16 est la voie de détresse et d’appel en phonie. La voie 70 est réservée à l’appel sélectif numérique et n’accepte aucune phonie (M10).',
//       },
//     ]}
//   />
//
// Les explications sont révélées après validation, indépendamment du succès.
//
// MODE EXAMEN — prop `secondsPerQuestion`
//
//   <Quiz id="blanc-1" secondsPerQuestion={22} questions={[...]} />
//
// Quand cette prop est fournie, le quiz reproduit les conditions réelles de
// l'examen du CRR : une question à la fois, compte à rebours visible, passage
// automatique à la suivante à l'expiration, et RETOUR EN ARRIÈRE IMPOSSIBLE.
// Ce n'est pas un ornement : l'ANFR impose 22 secondes par question sans
// retour arrière, et des candidats échouent sur la manipulation plutôt que
// sur la connaissance. La progression n'est pas sauvegardée en mode examen —
// un examen blanc se passe en direct.
//
// Sans cette prop, le comportement est exactement celui d'un QCM classique.

interface Question {
  question: string;
  choices: string[];
  answer: number;
  explanation?: string;
}

interface Props {
  id: string;
  questions: Question[];
  /** Seuil de réussite en pourcentage (défaut 80). */
  threshold?: number;
  /**
   * Active le mode examen chronométré : une question à la fois, compte à
   * rebours de N secondes, passage automatique, pas de retour en arrière.
   * Valeur de référence pour le CRR : 22.
   */
  secondsPerQuestion?: number;
}

const { id, questions, threshold = 80, secondsPerQuestion } = Astro.props;

const examen = typeof secondsPerQuestion === 'number' && secondsPerQuestion > 0;

// On encode les réponses pour le JS d'évaluation, sans les exposer en clair
// avant validation : pas une protection cryptographique, juste un anti-survol.
const correct = questions.map((q) => q.answer);
const explanations = questions.map((q) => q.explanation ?? '');
const payload = JSON.stringify({ correct, explanations, threshold });
---

<form
  class="quiz"
  data-quiz-id={id}
  data-quiz-payload={payload}
  data-exam-seconds={examen ? String(secondsPerQuestion) : undefined}
>
  {
    examen && (
      <div class="quiz-exam-bar">
        <span class="quiz-exam-progress" />
        <span class="quiz-exam-timer" role="timer" aria-live="off" />
      </div>
    )
  }
  <ol class="quiz-list">
    {
      questions.map((q, qi) => (
        <li class="quiz-question" data-question-index={qi}>
          <p class="quiz-prompt">
            <strong>Question {qi + 1}.</strong> {q.question}
          </p>
          <ul class="quiz-choices">
            {q.choices.map((choice, ci) => (
              <li>
                <label>
                  <input
                    type="radio"
                    name={`${id}-q${qi}`}
                    value={ci}
                    required={!examen}
                  />
                  <span>{choice}</span>
                </label>
              </li>
            ))}
          </ul>
          <p class="quiz-explanation" hidden />
        </li>
      ))
    }
  </ol>
  <div class="quiz-actions">
    {
      examen ? (
        <button type="button" class="quiz-next">
          Question suivante
        </button>
      ) : (
        <button type="submit" class="quiz-submit">
          Valider mes réponses
        </button>
      )
    }
    <button type="reset" class="quiz-reset">
      {examen ? "Recommencer l'examen" : 'Recommencer'}
    </button>
  </div>
  <p class="quiz-result" role="status" aria-live="polite"></p>
</form>

<style>
  .quiz {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    background: var(--sl-color-bg-nav);
  }
  .quiz-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .quiz-question + .quiz-question {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--sl-color-gray-5);
  }
  /* En mode examen, la question affichée est la première visible : elle ne
     doit pas hériter du filet de séparation d'une question masquée. */
  .quiz-question[hidden] + .quiz-question {
    border-top: 0;
    margin-top: 0;
    padding-top: 0;
  }
  .quiz-prompt {
    margin: 0 0 0.5rem;
  }
  .quiz-choices {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
  }
  .quiz-choices label {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    cursor: pointer;
    padding: 0.35rem 0.5rem;
    border-radius: 0.25rem;
  }
  .quiz-choices label:hover {
    background: var(--sl-color-gray-6);
  }
  /* Le rendu natif d'un input radio ne s'aligne pas fiablement sur la
     première ligne du texte voisin (taille et marges variables selon
     navigateur/OS). On le redessine à taille fixe pour un alignement
     constant, y compris quand le texte de la réponse passe à la ligne. */
  .quiz-choices input[type='radio'] {
    appearance: none;
    -webkit-appearance: none;
    flex-shrink: 0;
    width: 1.1em;
    height: 1.1em;
    margin: 0;
    border: 2px solid var(--sl-color-gray-3);
    border-radius: 50%;
    background: var(--sl-color-bg);
    cursor: pointer;
  }
  .quiz-choices input[type='radio']:checked {
    border-color: var(--sl-color-accent);
    background:
      radial-gradient(
        circle,
        var(--sl-color-accent) 0 40%,
        transparent 42% 100%
      ),
      var(--sl-color-bg);
  }
  .quiz-choices input[type='radio']:disabled {
    cursor: default;
    opacity: 0.75;
  }
  .quiz-choices input[type='radio']:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .quiz-choices label span {
    line-height: 1.1em;
  }
  .quiz-question[data-state='correct'] .quiz-choices label[data-chosen] {
    background: color-mix(in srgb, var(--sl-color-green) 25%, transparent);
  }
  .quiz-question[data-state='wrong'] .quiz-choices label[data-chosen] {
    background: color-mix(in srgb, var(--sl-color-red) 25%, transparent);
  }
  .quiz-question[data-state='wrong'] .quiz-choices label[data-correct],
  .quiz-question[data-state='correct'] .quiz-choices label[data-correct] {
    outline: 2px solid var(--sl-color-green);
    outline-offset: -2px;
  }
  .quiz-explanation {
    margin: 0.5rem 0 0;
    padding: 0.5rem 0.75rem;
    background: var(--sl-color-gray-6);
    border-left: 3px solid var(--sl-color-accent);
    font-size: 0.95em;
  }
  .quiz-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .quiz-submit,
  .quiz-next,
  .quiz-reset {
    font: inherit;
    padding: 0.45rem 0.9rem;
    border-radius: 0.3rem;
    border: 1px solid var(--sl-color-gray-5);
    cursor: pointer;
  }
  .quiz-submit,
  .quiz-next {
    background: var(--sl-color-accent);
    color: var(--sl-color-white);
    border-color: var(--sl-color-accent);
  }
  .quiz-next:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .quiz-reset {
    background: transparent;
    color: inherit;
  }
  .quiz-result {
    margin: 1rem 0 0;
    font-weight: 600;
  }
  .quiz-result[data-status='pass'] {
    color: var(--sl-color-green);
  }
  .quiz-result[data-status='fail'] {
    color: var(--sl-color-red);
  }

  /* Mode examen : bandeau de progression et compte à rebours. */
  .quiz-exam-bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    font-size: 0.95em;
  }
  .quiz-exam-progress {
    color: var(--sl-color-gray-2);
  }
  .quiz-exam-timer {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
  .quiz-exam-timer[data-low] {
    color: var(--sl-color-red);
  }
</style>

<script>
  // Évaluation locale du QCM ; rien n'est envoyé côté serveur.
  const evaluate = (form: HTMLFormElement) => {
    const payload = JSON.parse(form.dataset.quizPayload ?? '{}') as {
      correct: number[];
      explanations: string[];
      threshold: number;
    };
    const questions = form.querySelectorAll<HTMLLIElement>('.quiz-question');
    let good = 0;
    questions.forEach((q, qi) => {
      const expected = payload.correct[qi];
      const selected = q.querySelector<HTMLInputElement>(
        'input[type=radio]:checked',
      );
      const ok = selected && Number(selected.value) === expected;
      if (ok) good += 1;
      q.dataset.state = ok ? 'correct' : 'wrong';
      // marquage des labels
      q.querySelectorAll<HTMLLabelElement>('label').forEach((label, ci) => {
        delete label.dataset.chosen;
        delete label.dataset.correct;
        if (selected && Number(selected.value) === ci) label.dataset.chosen = '';
        if (ci === expected) label.dataset.correct = '';
      });
      // explication révélée
      const expl = q.querySelector<HTMLParagraphElement>('.quiz-explanation');
      if (expl && payload.explanations[qi]) {
        expl.textContent = payload.explanations[qi];
        expl.hidden = false;
      }
      // verrouillage des choix
      q.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((r) => {
        r.disabled = true;
      });
    });
    const total = questions.length;
    const pct = Math.round((good / total) * 100);
    const result = form.querySelector<HTMLParagraphElement>('.quiz-result');
    if (result) {
      const status = pct >= payload.threshold ? 'pass' : 'fail';
      result.dataset.status = status;
      result.textContent =
        status === 'pass'
          ? `Bravo : ${good}/${total} (${pct} %). Module validé sur ce quiz (seuil ${payload.threshold} %).`
          : `Score : ${good}/${total} (${pct} %). Sous le seuil de ${payload.threshold} % — relisez les explications et recommencez.`;
    }
  };

  const reset = (form: HTMLFormElement) => {
    form.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((r) => {
      r.disabled = false;
      r.checked = false;
    });
    form.querySelectorAll<HTMLLIElement>('.quiz-question').forEach((q) => {
      delete q.dataset.state;
      q.querySelectorAll<HTMLLabelElement>('label').forEach((label) => {
        delete label.dataset.chosen;
        delete label.dataset.correct;
      });
      const expl = q.querySelector<HTMLParagraphElement>('.quiz-explanation');
      if (expl) {
        expl.hidden = true;
        expl.textContent = '';
      }
    });
    const result = form.querySelector<HTMLParagraphElement>('.quiz-result');
    if (result) {
      result.textContent = '';
      delete result.dataset.status;
    }
  };

  // Persistance de la progression dans localStorage (navigateur uniquement,
  // rien n'est envoyé : le site est statique). Objectif : survivre aux
  // rechargements de page et aux republications du site — pas de compte,
  // pas de serveur, la progression reste sur l'appareil de l'apprenant.
  const STORAGE_PREFIX = 'quiz-progress:';

  interface QuizProgress {
    fp: string;
    selections: (number | null)[];
    submitted: boolean;
  }

  // Hachage simple (non cryptographique) du texte des questions et des
  // réponses : sert uniquement à détecter qu'un module a été modifié
  // depuis la dernière visite, pour ignorer une progression devenue
  // obsolète plutôt que de la réappliquer aux mauvaises réponses.
  const hashString = (s: string) => {
    let h = 0;
    for (let i = 0; i < s.length; i++) {
      h = (Math.imul(31, h) + s.charCodeAt(i)) | 0;
    }
    return h.toString(36);
  };

  const fingerprint = (form: HTMLFormElement) => {
    const parts: string[] = [];
    form.querySelectorAll<HTMLLIElement>('.quiz-question').forEach((q) => {
      const prompt = q.querySelector('.quiz-prompt')?.textContent?.trim() ?? '';
      const choices = Array.from(
        q.querySelectorAll<HTMLSpanElement>('.quiz-choices span'),
      ).map((s) => s.textContent?.trim() ?? '');
      parts.push(`${prompt}|${choices.join('~')}`);
    });
    return hashString(parts.join('##'));
  };

  const getSelections = (form: HTMLFormElement): (number | null)[] =>
    Array.from(form.querySelectorAll<HTMLLIElement>('.quiz-question')).map(
      (q) => {
        const checked = q.querySelector<HTMLInputElement>(
          'input[type=radio]:checked',
        );
        return checked ? Number(checked.value) : null;
      },
    );

  const saveProgress = (form: HTMLFormElement, submitted: boolean) => {
    try {
      const state: QuizProgress = {
        fp: fingerprint(form),
        selections: getSelections(form),
        submitted,
      };
      localStorage.setItem(
        STORAGE_PREFIX + form.dataset.quizId,
        JSON.stringify(state),
      );
    } catch {
      // Stockage indisponible (navigation privée, quota plein…) :
      // dégradation silencieuse, le quiz reste utilisable sans persistance.
    }
  };

  const clearProgress = (form: HTMLFormElement) => {
    try {
      localStorage.removeItem(STORAGE_PREFIX + form.dataset.quizId);
    } catch {
      /* idem */
    }
  };

  const restoreProgress = (form: HTMLFormElement) => {
    let saved: QuizProgress | null = null;
    try {
      const raw = localStorage.getItem(STORAGE_PREFIX + form.dataset.quizId);
      if (raw) saved = JSON.parse(raw) as QuizProgress;
    } catch {
      saved = null;
    }
    if (!saved) return;
    if (saved.fp !== fingerprint(form)) {
      // Le contenu du module a changé depuis : la progression sauvegardée
      // ne correspond plus aux questions actuelles, on l'écarte.
      clearProgress(form);
      return;
    }
    form.querySelectorAll<HTMLLIElement>('.quiz-question').forEach((q, qi) => {
      const choice = saved!.selections[qi];
      if (choice === null || choice === undefined) return;
      const input = q.querySelector<HTMLInputElement>(
        `input[type=radio][value="${choice}"]`,
      );
      if (input) input.checked = true;
    });
    if (saved.submitted) evaluate(form);
  };

  // Mode examen : reproduit les conditions de l'épreuve du CRR — une question
  // à la fois, 22 secondes, passage automatique, aucun retour en arrière.
  // Rien n'est persisté : un examen blanc se passe en direct.
  const initExam = (form: HTMLFormElement, seconds: number) => {
    const questions = Array.from(
      form.querySelectorAll<HTMLLIElement>('.quiz-question'),
    );
    const timerEl = form.querySelector<HTMLSpanElement>('.quiz-exam-timer');
    const progressEl = form.querySelector<HTMLSpanElement>(
      '.quiz-exam-progress',
    );
    const nextBtn = form.querySelector<HTMLButtonElement>('.quiz-next');
    if (!questions.length || !timerEl || !progressEl || !nextBtn) return;

    let current = 0;
    let remaining = seconds;
    let ticker = 0;

    const stopTicker = () => {
      if (ticker) {
        window.clearInterval(ticker);
        ticker = 0;
      }
    };

    const paint = () => {
      questions.forEach((q, i) => {
        q.hidden = i !== current;
      });
      progressEl.textContent = `Question ${current + 1} / ${questions.length}`;
      nextBtn.textContent =
        current === questions.length - 1 ? 'Terminer' : 'Question suivante';
    };

    const showTime = () => {
      timerEl.textContent = `${remaining} s`;
      if (remaining <= 5) timerEl.dataset.low = '';
      else delete timerEl.dataset.low;
    };

    const finish = () => {
      stopTicker();
      // On réaffiche tout : la correction se lit d'un bloc, comme sur un
      // quiz normal.
      questions.forEach((q) => {
        q.hidden = false;
      });
      timerEl.textContent = 'terminé';
      delete timerEl.dataset.low;
      progressEl.textContent = `${questions.length} questions`;
      nextBtn.disabled = true;
      evaluate(form);
    };

    const advance = () => {
      // Verrouillage immédiat : on ne revient pas en arrière, exactement
      // comme à l'examen.
      const q = questions[current];
      if (q) {
        q.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach(
          (r) => {
            r.disabled = true;
          },
        );
      }
      if (current >= questions.length - 1) {
        finish();
        return;
      }
      current += 1;
      remaining = seconds;
      paint();
      showTime();
    };

    const start = () => {
      stopTicker();
      remaining = seconds;
      showTime();
      ticker = window.setInterval(() => {
        remaining -= 1;
        showTime();
        if (remaining <= 0) advance();
      }, 1000);
    };

    nextBtn.addEventListener('click', advance);
    // Un appui sur Entrée ne doit pas soumettre le formulaire : en mode
    // examen, seul le bouton (ou le chronomètre) fait avancer.
    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('reset', (e) => {
      e.preventDefault();
      reset(form);
      current = 0;
      nextBtn.disabled = false;
      paint();
      start();
    });

    paint();
    start();
  };

  document.querySelectorAll<HTMLFormElement>('form.quiz').forEach((form) => {
    const examSeconds = Number(form.dataset.examSeconds);
    if (examSeconds > 0) {
      initExam(form, examSeconds);
      return;
    }

    restoreProgress(form);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      evaluate(form);
      saveProgress(form, true);
    });
    form.addEventListener('reset', (e) => {
      e.preventDefault();
      reset(form);
      clearProgress(form);
    });
    form.addEventListener('change', (e) => {
      if ((e.target as HTMLElement)?.matches('input[type=radio]')) {
        saveProgress(form, false);
      }
    });
  });
</script>
